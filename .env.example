# Which Payload instance this app talks to. Always point at staging first.
# Note the actual staging domain is audif1team.com, not audif1.com.
PAYLOAD_API_URL=https://staging.audif1team.com/cms/api
# SEO Studio authenticates as the dedicated staging CMS user saved via
# /admin/credentials (see lib/settings.ts) — it logs in server-side with
# that user's email/password against /cms/api/users/login and uses the
# returned JWT. The Users collection on this CMS doesn't have Payload's
# "API Key" auth enabled, so there is no separate PAYLOAD_API_KEY var;
# nothing else needed here beyond ADMIN_EMAILS/KV/CREDENTIALS_ENCRYPTION_KEY
# below, which already carry that login.

NEXT_PUBLIC_APP_ENV=staging

# --- Sign-in (NextAuth + Google, same slash.digital restriction as UTM Studio) ---
# Any long random string — signs the session cookie/JWT.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth client. Can reuse UTM Studio's existing Google Cloud OAuth client
# (479946723464-lep5li73plr2ok39js31u14pgsekmrgo.apps.googleusercontent.com)
# as long as this app's callback URL is added to its Authorized redirect URIs:
#   https://<this-app's-domain>/api/auth/callback/google
# NextAuth needs a client *secret* too, which UTM Studio's client-side-only
# Google Identity Services flow doesn't use but the same Google Cloud OAuth
# client still has one issued — grab it from the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who gets into /admin (and, while ALLOW_ALL_SLASH_DIGITAL is off, who can
# sign in at all). Comma-separated emails. Matches UTM Studio's bootstrap
# admin by default.
ADMIN_EMAILS=tma@slash.digital
# Flip to "true" once ready to open the four tools up to every @slash.digital
# account, same as UTM Studio's "editor" role. /admin stays ADMIN_EMAILS-only
# either way.
ALLOW_ALL_SLASH_DIGITAL=false

# --- Admin section (/admin) ---
# Encrypts secrets (e.g. the staging login) before they're written to KV.
# Any passphrase works — it's hashed down to a key, doesn't need to be exact-length.
CREDENTIALS_ENCRYPTION_KEY=

# --- Storage for admin-managed secrets (lib/kv.ts) ---
# Add the Vercel KV / Upstash Redis integration to this project and these two
# are injected automatically. Without them, admin-saved values (e.g. the
# staging login) only live in memory and vanish on the next redeploy/cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=
