# Which Payload instance this app talks to. Always point at staging first.
PAYLOAD_API_URL=https://staging.audif1.com/cms/api
# Service-account API key (Payload "API Key" auth on a dedicated service user),
# used server-side only (Next.js API routes / route handlers) — never exposed to the client.
PAYLOAD_API_KEY=

# App-level sign-in, so activity can be attributed per person rather than to the shared
# Payload service account. Fill in once auth is wired up (see README "Activity logging").
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_ENV=staging

# --- Admin section (/admin) ---
# Gate for the admin area itself (single shared password for now, pre-real-auth).
ADMIN_PASSWORD=
# Signs the admin session cookie. Any long random string.
ADMIN_SECRET=
# Encrypts secrets (e.g. the staging login below) before they're written to KV.
# Any passphrase works — it's hashed down to a key, doesn't need to be exact-length.
CREDENTIALS_ENCRYPTION_KEY=

# --- Storage for admin-managed secrets (lib/kv.ts) ---
# Add the Vercel KV / Upstash Redis integration to this project and these two
# are injected automatically. Without them, admin-saved values (e.g. the
# staging login) only live in memory and vanish on the next redeploy/cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=
